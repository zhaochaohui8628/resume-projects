 "reject_reason": "①与工程指标无关的名词；②仅作构词成分；③泛化量名（裸标必 FP，gold_test 实证不认可，移入此表）；④设备或表格名",
 "spec_value_patterns": [
  {
   "name": "径规格",
   "regex": "[∅Φφ]\\s?\\d{2,4}(\\s?@\\s?\\d{2,4})?",
   "desc": "桩径/桩距规格：∅800@600、∅650、φ1100"
  },
  {
   "name": "强度等级值",
   "regex": "(?<![A-Za-z0-9])C\\d{2}(?!\\d)",
   "desc": "混凝土强度等级值：C15/C30/C35"
  },
  {
   "name": "抗渗等级",
   "regex": "(?:抗渗等级?|等级)\\s?P(?:6|8|10|12)(?![0-9])",
   "desc": "抗渗等级：P8"
  }
 ],
 "annotate_rule": {
  "desc": "定稿口径：只标 A（裸指标量名）+ SPEC（纯规格值/强度等级）；量名与值分离标注（gold 实证：安全间距≥500mm → 两个实体）；比较词短语不合并",
  "merge_adjacent_value": false,
  "merge_threshold_phrase": false
 },
